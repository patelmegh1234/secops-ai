# ═══════════════════════════════════════════════════════════════
# SecOps-AI — Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to git.
# ═══════════════════════════════════════════════════════════════

# ─── Application ───────────────────────────────────────────────
APP_NAME="SecOps-AI"
APP_ENV="development"          # development | staging | production
APP_PORT=8000
SECRET_KEY="change-me-to-a-64-char-random-hex-string"
DEBUG=true

# ─── Database (Supabase PostgreSQL) ────────────────────────────
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL="postgresql+asyncpg://postgres:password@localhost:5432/secops_ai"
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ─── Redis (Upstash or local) ──────────────────────────────────
# Format: redis://:password@host:port/db
REDIS_URL="redis://localhost:6379/0"

# ─── JWT Authentication ─────────────────────────────────────────
JWT_SECRET_KEY="change-me-to-a-64-char-random-secret"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── GitHub Integration ─────────────────────────────────────────
# Personal Access Token with: repo, read:org, workflow scopes
GITHUB_TOKEN="ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Webhook secret set in GitHub repo settings → Webhooks
GITHUB_WEBHOOK_SECRET="your-github-webhook-secret"
# Default org/user for PR creation
GITHUB_DEFAULT_OWNER="your-github-username"

# ─── OpenAI ─────────────────────────────────────────────────────
OPENAI_API_KEY="sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Primary model for patch generation (expensive, high quality)
OPENAI_PRIMARY_MODEL="gpt-4o"
# Secondary model for triage (fast, cheap)
OPENAI_SECONDARY_MODEL="gpt-4o-mini"

# ─── Anthropic (optional fallback) ─────────────────────────────
ANTHROPIC_API_KEY="sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
ANTHROPIC_MODEL="claude-sonnet-4-5"

# ─── Slack Integration ─────────────────────────────────────────
# Bot Token (xoxb-...) from Slack App → OAuth & Permissions
SLACK_BOT_TOKEN="xoxb-xxxxxxxxxxxx-xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxx"
# Signing Secret from Slack App → Basic Information
SLACK_SIGNING_SECRET="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Channel ID to post vulnerability alerts
SLACK_ALERT_CHANNEL_ID="C0XXXXXXXXX"
# Your app's public URL (Railway URL) — used for Slack action callbacks
SLACK_APP_BASE_URL="https://your-railway-app.railway.app"

# ─── Rate Limiting ──────────────────────────────────────────────
RATE_LIMIT_WEBHOOKS="30/minute"
RATE_LIMIT_API="100/minute"

# ─── CORS ───────────────────────────────────────────────────────
# Comma-separated list of allowed origins (your Vercel dashboard URL)
ALLOWED_ORIGINS="http://localhost:3000,https://your-app.vercel.app"

# ─── Docker Sandbox ─────────────────────────────────────────────
SANDBOX_TIMEOUT_SECONDS=30
SANDBOX_MEMORY_LIMIT="512m"
SANDBOX_CPU_QUOTA=50000   # 50% of one core
SANDBOX_BASE_IMAGE="python:3.11-slim"

# ─── Celery ─────────────────────────────────────────────────────
CELERY_BROKER_URL="redis://localhost:6379/1"
CELERY_RESULT_BACKEND="redis://localhost:6379/2"
CELERY_TASK_MAX_RETRIES=2
CELERY_TASK_RETRY_DELAY_SECONDS=5

# ─── Observability ──────────────────────────────────────────────
LOG_LEVEL="INFO"    # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT="json"   # json | console
