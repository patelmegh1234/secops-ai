# SecOps-AI Dashboard — Environment Variables
# Copy this to .env.local for local development

# ── Backend API ───────────────────────────────────────────────────────────────
# Set to your Railway/Render backend URL in production.
# Leave empty to use demo/mock data mode (great for Vercel-only deploys).
NEXT_PUBLIC_API_URL=

# Set to "true" to always use demo data regardless of API_URL
NEXT_PUBLIC_DEMO_MODE=true

# ── WebSocket ─────────────────────────────────────────────────────────────────
# Auto-derived from API_URL if not set (http→ws, https→wss)
NEXT_PUBLIC_WS_URL=
